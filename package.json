{
  "name": "printer-hub",
  "version": "0.22.1",
  "released": "2026-11-03",
  "description": "Self-hosted dashboard, control panel, slicer and job log for FlashForge Adventurer 5M and Anycubic Kobra X printers",
  "keywords": [
    "3d-printing",
    "flashforge",
    "adventurer-5m",
    "anycubic",
    "kobra-x",
    "orcaslicer",
    "dashboard",
    "self-hosted"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Shawman511/printer-hub.git"
  },
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node server.js",
    "demo": "node server.js --config config.demo.json",
    "test": "node --test --test-timeout=60000 \"test/*.test.js\""
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "mpegts.js": "1.7.3",
    "mqtt": "5.10.1",
    "three": "0.169.0"
  }
}
